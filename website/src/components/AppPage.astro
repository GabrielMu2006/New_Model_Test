---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArtifactPreview from './ArtifactPreview.astro';
import RunRow from './RunRow.astro';
import {
  asset, assessmentsForModel, batchForModel, catalog, compact, duration, href, modelById, number,
  reviewsFor, runById, runCards, runsForModel, runsForTask, sourceUrl, taskById, type Locale,
} from '../lib/catalog';
import { renderMarkdown } from '../lib/markdown';

interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const bits = path.split('/').filter(Boolean);
const section = bits[0] || 'home';
const id = bits[1];
const l = locale === 'zh';
const labels = l ? {
  overview: '模型评测档案', intro: '浏览多模型在同一套题目上的真实成果、原始需求、运行证据与彼此独立的评价来源。', browse: '浏览任务', compare: '同题对比', phase: '阶段', model: '模型', models: '模型', tasks: '任务', artifacts: '成果', runs: '运行', duration: '累计用时', tokens: 'Token 过路量', filters: '检索与筛选', search: '搜索任务标题、Prompt 或模型', category: '全部类别', allModelsFilter: '全部模型', noResults: '没有符合条件的任务。', view: '查看详情', source: '来源', prompt: '原始 Prompt', translation: '中文译文', expected: '理论成果', verification: '后补验收建议', runDetails: '运行记录', metrics: '运行指标', reviews: '评价与证据', human: '人工评价', ai: 'AI 评价', method: '评测方法', notRecorded: '未记录', config: '执行配置', session: '会话', continuation: '补充轮', disclaimer: '引用结论，不代表网站独立复验', allTasks: '全部任务', allModels: '全部模型', phaseDetail: '阶段详情', modelDetail: '模型详情', methodology: '评测方法与边界', compareTitle: '同题运行对比', selectTask: '选择任务', left: '左侧运行', right: '右侧运行', unavailable: '当前任务只有一条真实运行记录，尚无第二项可比较。', invalid: '无效或不匹配的选择已被忽略。', share: '复制分享链接', copied: '链接已复制', archive: '归档版本', sourceReport: '原始报告', results: '项结果', total: '合计', perTask: '逐任务记录', batchStats: '批次统计', promptInput: '逐字输入', postHoc: '事后补录', isolation: '隔离等级', contamination: '污染状态', assessment: '阶段评估', allRuns: '全部运行', translationNote: '原文为中文，未提供英译', translatedNote: '英文为译文', cost: '费用', harness: 'Harness', crossModel: '跨模型比较需注明 harness、预算与隔离差异。', taskRuns: '本题全部运行', compareHint: '同一任务版本下的两次运行可并排比较。',
} : {
  overview: 'Model evaluation archive', intro: 'Browse real artifacts from multiple models on the same task set, with original requests, run evidence, and independent review sources.', browse: 'Browse tasks', compare: 'Compare runs', phase: 'Phase', model: 'Model', models: 'Models', tasks: 'Tasks', artifacts: 'Artifacts', runs: 'Runs', duration: 'Total duration', tokens: 'Token throughput', filters: 'Search and filters', search: 'Search task title, prompt or model', category: 'All categories', allModelsFilter: 'All models', noResults: 'No tasks match these filters.', view: 'View details', source: 'Source', prompt: 'Original prompt', translation: 'Chinese translation', expected: 'Expected outcome', verification: 'Additional verification guidance', runDetails: 'Run record', metrics: 'Run metrics', reviews: 'Reviews and evidence', human: 'Human review', ai: 'AI review', method: 'Methodology', notRecorded: 'Not recorded', config: 'Execution configuration', session: 'Session', continuation: 'Continuation turns', disclaimer: 'Quoted conclusion; not independently reverified by this website', allTasks: 'All tasks', allModels: 'All models', phaseDetail: 'Phase details', modelDetail: 'Model details', methodology: 'Methodology and boundaries', compareTitle: 'Compare runs on one task', selectTask: 'Select task', left: 'Left run', right: 'Right run', unavailable: 'Only one real run exists for this task, so there is no second result to compare yet.', invalid: 'Invalid or mismatched selections were ignored.', share: 'Copy share link', copied: 'Link copied', archive: 'Archive version', sourceReport: 'Source report', results: 'results', total: 'Total', perTask: 'Per-task records', batchStats: 'Batch metrics', promptInput: 'Verbatim input', postHoc: 'post-hoc reconstruction', isolation: 'Isolation level', contamination: 'Contamination', assessment: 'Phase assessment', allRuns: 'All runs', translationNote: 'Original Chinese; no English translation provided', translatedNote: 'English is a translation', cost: 'Cost', harness: 'Harness', crossModel: 'Cross-model comparison must note harness, budget and isolation differences.', taskRuns: 'All runs for this task', compareHint: 'Two runs of the same task version can be compared side by side.',
};
const categoryNames: Record<string, string> = l ? { website: '网站', 'svg-illustration': 'SVG 插画', 'svg-clock': 'SVG 时钟', game: '游戏', 'creative-tool': '创作工具', 'productivity-tool': '效率工具', utility: '实用工具', 'data-dashboard': '数据仪表盘' } : { website: 'Website', 'svg-illustration': 'SVG illustration', 'svg-clock': 'SVG clock', game: 'Game', 'creative-tool': 'Creative tool', 'productivity-tool': 'Productivity tool', utility: 'Utility', 'data-dashboard': 'Data dashboard' };
const isolationLabels: Record<string, { zh: string; en: string }> = {
  'workspace-only': { zh: '策略级（workspace-only）', en: 'Policy-level (workspace-only)' },
  'os-user-isolation': { zh: '独立用户隔离', en: 'Separate OS user' },
  container: { zh: '容器隔离', en: 'Container' },
  unknown: { zh: '未记录', en: 'Not recorded' },
};
const contaminationLabels: Record<string, { zh: string; en: string }> = {
  clean: { zh: 'clean（已声明范围内通过）', en: 'clean (passed within declared scope)' },
  suspected: { zh: 'suspected', en: 'suspected' },
  contaminated: { zh: 'contaminated', en: 'contaminated' },
  unknown: { zh: 'unknown', en: 'unknown' },
};
const currentTask = taskById(id);
const currentRun = runById(id);
const currentModel = modelById(id);
const pageTitle = currentTask?.title[locale] || currentModel?.name || (section === 'compare' ? labels.compareTitle : section === 'methodology' ? labels.methodology : section === 'phases' ? labels.phaseDetail : section === 'models' ? labels.allModels : section === 'tasks' ? labels.allTasks : currentRun ? currentTask?.title[locale] : labels.overview);
const alternatePath = path;
const cards = runCards();
const featured = catalog.tasks.slice(0, 4).flatMap((task) => catalog.models.map((model) => {
  const run = catalog.runs.find((item) => item.taskId === task.id && item.modelId === model.id);
  return run ? { task, run, model } : null;
}).filter((entry): entry is { task: typeof task; run: (typeof catalog.runs)[number]; model: (typeof catalog.models)[number] } => Boolean(entry)));
const github = (p: string, lines?: string, commit?: string) => sourceUrl(p, lines, commit);
const metricItems = (run: (typeof catalog.runs)[number]) => [
  ['Duration', run.metrics.durationLabel], ['API', number(run.metrics.apiCalls, locale)], ['Tools', number(run.metrics.toolCalls, locale)],
  ['Failures / retries', number(run.metrics.failures, locale)], ['Input tokens', number(run.metrics.inputTokens, locale)],
  ['Output tokens', number(run.metrics.outputTokens, locale)], ['Cache read', number(run.metrics.cacheReadTokens, locale)],
  ['Total tokens', number(run.metrics.totalTokens, locale)],
];
---
<SiteLayout locale={locale} title={pageTitle || labels.overview} description={labels.intro} alternatePath={alternatePath}>
  {section === 'home' && <>
    <section class="hero shell">
      <div class="hero-copy">
        <span class="eyebrow">{catalog.models.length} MODELS · PHASE 01</span>
        <h1>{labels.overview}</h1>
        <p>{labels.intro}</p>
        <div class="button-row"><a class="button primary" href={href(locale, 'tasks/')}>{labels.browse}</a><a class="button" href={href(locale, 'compare/')}>{labels.compare}</a></div>
      </div>
      <div class="signal-card" aria-label={l ? '归档概况' : 'Archive summary'}>
        <span>ARCHIVE SIGNAL</span><b>{catalog.tasks.length} / {catalog.tasks.length}</b><i></i>
        <dl>
          <div><dt>{labels.models}</dt><dd>{catalog.models.length}</dd></div>
          <div><dt>{labels.phase}</dt><dd>{catalog.phases.length}</dd></div>
          <div><dt>{labels.runs}</dt><dd>{catalog.runs.length}</dd></div>
        </dl>
      </div>
    </section>
    <section class="stats shell" aria-label={labels.batchStats}>
      {catalog.batches.map((batch) => {
        const model = modelById(batch.modelId);
        return <div>
          <span>{model?.name}</span>
          <strong>{duration(batch.metrics.durationSeconds, locale)}</strong>
          <small>{compact(batch.metrics.totalTokens, locale)} tokens · {number(batch.metrics.apiCalls, locale)} API · {batch.metrics.costCny == null ? labels.notRecorded : `¥${batch.metrics.costCny}`}</small>
        </div>;
      })}
      <div><span>{labels.artifacts}</span><strong>{catalog.runs.filter((run) => run.artifact.type === 'svg').length} SVG / {catalog.runs.filter((run) => run.artifact.type === 'html').length} HTML</strong><small>{labels.results}</small></div>
    </section>
    <section class="shell section-block">
      <div class="section-heading"><div><span class="eyebrow">CATALOG</span><h2>{labels.tasks}</h2></div><a href={href(locale, 'tasks/')}>{labels.allTasks} →</a></div>
      <div class="artifact-strip">
        {featured.map(({ task, run, model }) => <a class="artifact-tile" href={href(locale, `tasks/${task.id}/`)}>
          <div class="tile-visual">{run.artifact.type === 'svg' ? <img src={asset(`artifacts/${run.id}/${run.artifact.entry}`)} alt="" /> : run.artifact.cover ? <img src={asset(run.artifact.cover)} alt="" /> : <span>{task.id}</span>}</div>
          <span>{task.id} · {model?.name}</span><strong>{task.title[locale]}</strong>
        </a>)}
      </div>
    </section>
  </>}

  {section === 'tasks' && !id && <section class="shell page-block">
    <div class="page-heading"><span class="eyebrow">{catalog.runs.length} RUNS / {catalog.models.length} MODELS</span><h1>{labels.allTasks}</h1><p>{labels.intro}</p></div>
    <div class="filter-panel" data-filter-panel>
      <label><span>{labels.search}</span><input type="search" data-search placeholder={labels.search} /></label>
      <label><span>{l ? '任务类别' : 'Task category'}</span><select data-category><option value="">{labels.category}</option>{Object.entries(categoryNames).map(([value, name]) => <option value={value}>{name}</option>)}</select></label>
      <label><span>{labels.model}</span><select data-model><option value="">{labels.allModelsFilter}</option>{catalog.models.map((model) => <option value={model.id}>{model.name}</option>)}</select></label>
    </div>
    <div class="task-grid" data-task-grid>
      {cards.map(({ task, run, model }) => <article class="task-card" data-task-card data-category={task.category} data-model={run.modelId} data-search={`${task.title.zh} ${task.title.en} ${task.promptOriginal} ${model?.name ?? ''}`.toLowerCase()}>
        <a class="task-visual" href={href(locale, `runs/${run.id}/`)}>{run.artifact.type === 'svg' ? <img src={asset(`artifacts/${run.id}/${run.artifact.entry}`)} alt="" loading="lazy" /> : run.artifact.cover ? <img src={asset(run.artifact.cover)} alt="" loading="lazy" /> : <span>{run.artifact.type}</span>}<em>{run.artifact.type.toUpperCase()}</em></a>
        <div class="task-card-body"><span class="eyebrow">{task.id} · {model?.name}</span><h2>{task.title[locale]}</h2><p>{task.promptOriginal}</p><a href={href(locale, `runs/${run.id}/`)}>{labels.view} →</a></div>
      </article>)}
    </div>
    <p class="empty-state" data-empty hidden>{labels.noResults}</p>
  </section>}

  {section === 'tasks' && currentTask && (() => {
    const taskRuns = runsForTask(currentTask.id);
    const primary = taskRuns[0];
    return <section class="shell page-block detail-page">
      <div class="breadcrumb"><a href={href(locale, 'tasks/')}>{labels.tasks}</a><span>/</span><span>{currentTask.id}</span></div>
      <div class="detail-heading"><div><span class="eyebrow">{currentTask.id} · V{currentTask.version} · {categoryNames[currentTask.category]}</span><h1>{currentTask.title[locale]}</h1></div><a class="button" href={href(locale, `compare/?task=${currentTask.id}&left=${taskRuns[0]?.id ?? ''}${taskRuns[1] ? `&right=${taskRuns[1].id}` : ''}`)}>{labels.compare}</a></div>
      {primary && <ArtifactPreview locale={locale} task={currentTask} run={primary} />}
      <div class="detail-columns">
        <article class="prose-card"><span class="eyebrow">SOURCE REQUEST</span><h2>{labels.prompt}</h2><pre>{currentTask.promptOriginal}</pre><h3>{labels.translation}</h3><p>{currentTask.promptTranslation}</p><a href={github(currentTask.source.path, currentTask.source.lines, primary?.artifact.commit)} target="_blank" rel="noopener">{labels.source} · {currentTask.source.path} ↗</a></article>
        <article class="prose-card"><span class="eyebrow">EVALUATION FRAME</span><h2>{labels.expected}</h2><p>{currentTask.expectedOutcome[locale]}</p><h3>{labels.verification}</h3><ul>{currentTask.verification[locale].map((item) => <li>{item}</li>)}</ul></article>
      </div>
      <div class="section-heading"><div><span class="eyebrow">RUNS</span><h2>{labels.taskRuns}</h2></div></div>
      <div class="run-list">{taskRuns.map((run) => <RunRow locale={locale} run={run} />)}</div>
    </section>;
  })()}

  {section === 'runs' && currentRun && (() => {
    const task = taskById(currentRun.taskId)!;
    const model = modelById(currentRun.modelId)!;
    const reviews = reviewsFor(currentRun.id);
    return <section class="shell page-block detail-page">
      <div class="breadcrumb"><a href={href(locale, 'tasks/')}>{labels.tasks}</a><span>/</span><a href={href(locale, `tasks/${task.id}/`)}>{task.id}</a><span>/</span><span>{labels.runs}</span></div>
      <div class="detail-heading"><div><span class="eyebrow">RUN RECORD / {task.id}@{currentRun.taskVersion} · {model?.name}</span><h1>{task.title[locale]}</h1><p>{currentRun.id}</p></div><span class="verified-badge">ARCHIVED · {currentRun.artifact.commit.slice(0, 7)}</span></div>
      <ArtifactPreview locale={locale} task={task} run={currentRun} />
      {currentRun.prompt && <section class="source-card"><span>{labels.promptInput}</span><code>{currentRun.prompt.path}</code><code>sha256:{currentRun.prompt.sha256.slice(0, 16)}…</code>{currentRun.prompt.provenance === 'post-hoc-reconstruction' && <b class="verified-badge">{labels.postHoc}</b>}<a href={github(currentRun.prompt.path, undefined, currentRun.artifact.commit)} target="_blank" rel="noopener">{labels.source} ↗</a></section>}
      <section class="section-block"><div class="section-heading"><div><span class="eyebrow">MEASUREMENTS</span><h2>{labels.metrics}</h2></div><a href={github(currentRun.source.path, currentRun.source.lines, currentRun.artifact.commit)} target="_blank" rel="noopener">{labels.sourceReport} ↗</a></div>
        <div class="metric-grid">{metricItems(currentRun).map(([key, value]) => <div><span>{key}</span><strong>{value}</strong></div>)}</div>
        <div class="config-line"><span>{labels.config}</span><b>{labels.harness}: {currentRun.environment.harness}{currentRun.environment.harnessVersion ? ` ${currentRun.environment.harnessVersion}` : ''}</b><b>{labels.session}: {currentRun.environment.sessionId}</b><b>{labels.continuation}: {currentRun.environment.continuationTurns}</b>{currentRun.environment.reasoningEffort && <b>reasoning: {currentRun.environment.reasoningEffort}</b>}</div>
        {currentRun.isolation && <div class="config-line"><span>{labels.isolation}</span><b>{isolationLabels[currentRun.isolation.level]?.[locale] ?? currentRun.isolation.level}</b>{currentRun.isolation.note && <small>{currentRun.isolation.note}</small>}</div>}
        {currentRun.contamination && <div class="config-line"><span>{labels.contamination}</span><b>{contaminationLabels[currentRun.contamination.status]?.[locale] ?? currentRun.contamination.status}</b>{currentRun.contamination.note && <small>{currentRun.contamination.note}</small>}</div>}
      </section>
      <section class="section-block"><div class="section-heading"><div><span class="eyebrow">INDEPENDENT SOURCES</span><h2>{labels.reviews}</h2></div></div>
        <div class="review-grid">{reviews.map((review) => <article class={`review-card ${review.type}`}><div class="review-meta"><span>{review.type === 'human' ? labels.human : labels.ai}</span>{review.score != null && <strong>{review.score}/100</strong>}</div><h3>{review.conclusion[locale]}</h3><div class="review-body" set:html={renderMarkdown(review.body[locale])} />{review.translated === false && <small>{labels.translationNote}</small>}{review.translated === true && review.type === 'human' && <small>{labels.translatedNote}</small>}{review.type === 'ai' && <small>{labels.disclaimer}</small>}<a href={github(review.source.path, review.source.lines, currentRun.artifact.commit)} target="_blank" rel="noopener">{review.authorLabel} ↗</a></article>)}</div>
      </section>
      <section class="source-card"><span>{labels.archive}</span><code>{currentRun.artifact.commit}</code><a href={github(currentRun.artifact.sourcePath, undefined, currentRun.artifact.commit)} target="_blank" rel="noopener">{currentRun.artifact.sourcePath} ↗</a></section>
    </section>;
  })()}

  {section === 'models' && !id && <section class="shell page-block"><div class="page-heading"><span class="eyebrow">MODEL INDEX</span><h1>{labels.allModels}</h1></div><div class="model-list">{catalog.models.map((model) => {
    const modelRuns = runsForModel(model.id);
    const batch = batchForModel(model.id);
    const assessment = assessmentsForModel(model.id)[0];
    return <a class="model-card" href={href(locale, `models/${model.id}/`)}><span class="model-monogram">{model.name.slice(0, 2).toUpperCase()}</span><div><span class="eyebrow">{model.provider} · {model.version}</span><h2>{model.name}</h2><p>{modelRuns.length} {labels.results} · {batch ? duration(batch.metrics.durationSeconds, locale) : labels.notRecorded}{assessment ? ` · ${assessment.score}/100` : ''}</p></div><b>→</b></a>;
  })}</div></section>}

  {section === 'models' && currentModel && <section class="shell page-block"><div class="breadcrumb"><a href={href(locale, 'models/')}>{labels.models}</a><span>/</span><span>{currentModel.id}</span></div><div class="page-heading"><span class="eyebrow">{currentModel.provider} · {currentModel.version}</span><h1>{currentModel.name}</h1><p>{currentModel.notes[locale]}</p></div>
    {(() => { const batch = batchForModel(currentModel.id); const assessments = assessmentsForModel(currentModel.id); return <>
      {batch && <div class="metric-grid">{[['Tasks', batch.metrics.totalTasks], ['Sessions', batch.metrics.sessions], ['Duration', duration(batch.metrics.durationSeconds, locale)], ['API', batch.metrics.apiCalls], ['Tools', batch.metrics.toolCalls], ['Failures / retries', batch.metrics.failures], ['Input tokens', number(batch.metrics.inputTokens, locale)], ['Output tokens', number(batch.metrics.outputTokens, locale)], ['Cache read', number(batch.metrics.cacheReadTokens, locale)], [labels.cost, batch.metrics.costCny == null ? labels.notRecorded : `¥${batch.metrics.costCny}`]].map(([key, value]) => <div><span>{key}</span><strong>{value}</strong></div>)}</div>}
      {assessments.map((assessment) => <article class="prose-card wide"><h2>{labels.assessment} · {assessment.label[locale]}</h2><p><strong>{assessment.score == null ? labels.notRecorded : `${assessment.score}/100`}</strong>{assessment.coreSummary ? ` · ${assessment.coreSummary}` : ''}</p><small>{assessment.disclaimer}</small><a href={github(assessment.source.path, assessment.source.lines, catalog.runs.find((run) => run.modelId === currentModel.id)?.artifact.commit)} target="_blank" rel="noopener">{labels.sourceReport} ↗</a></article>)}
    </>; })()}
    <div class="section-heading"><div><span class="eyebrow">RUNS</span><h2>{labels.allRuns}</h2></div></div>
    <div class="task-grid compact-grid">{runsForModel(currentModel.id).map((run) => { const task = taskById(run.taskId)!; return <article class="run-tile"><span>{task.id}</span><h2>{task.title[locale]}</h2><dl><div><dt>{labels.duration}</dt><dd>{run.metrics.durationLabel}</dd></div><div><dt>Tokens</dt><dd>{compact(run.metrics.totalTokens, locale)}</dd></div></dl><a href={href(locale, `runs/${run.id}/`)}>{labels.view} →</a></article>; })}</div></section>}

  {section === 'phases' && !id && <section class="shell page-block"><div class="page-heading"><span class="eyebrow">PHASE INDEX</span><h1>{labels.phase}</h1></div>{catalog.phases.map((phase) => <a class="phase-card" href={href(locale, `phases/${phase.id}/`)}><b>{String(phase.number).padStart(2, '0')}</b><div><span class="eyebrow">{phase.id}</span><h2>{phase.name[locale]}</h2><p>{phase.description[locale]}</p></div><strong>{phase.taskVersions.length} {labels.tasks} →</strong></a>)}</section>}

  {section === 'phases' && id && catalog.phases.some((phase) => phase.id === id) && (() => {
    const phase = catalog.phases.find((item) => item.id === id)!;
    const phaseTasks = catalog.tasks.filter((task) => task.phaseId === phase.id);
    return <section class="shell page-block"><div class="breadcrumb"><a href={href(locale, 'phases/')}>{labels.phase}</a><span>/</span><span>{phase.id}</span></div><div class="page-heading"><span class="eyebrow">PHASE {String(phase.number).padStart(2, '0')} · COMPLETE ARCHIVE</span><h1>{phase.name[locale]}</h1><p>{phase.description[locale]}</p></div><div class="timeline"><span></span><b>{String(phase.number).padStart(2, '0')}</b><i></i><strong>{phaseTasks.length} {labels.tasks}</strong><i></i><strong>{catalog.models.length} {labels.models}</strong><i></i><strong>{catalog.runs.filter((run) => phaseTasks.some((task) => task.id === run.taskId)).length} {labels.runs}</strong></div>
      <div class="task-grid compact-grid">{phaseTasks.map((task) => { const taskRuns = runsForTask(task.id); return <article class="run-tile"><span>{task.id}</span><h2>{task.title[locale]}</h2><p>{categoryNames[task.category]}</p><dl>{taskRuns.map((run) => <div><dt>{modelById(run.modelId)?.name}</dt><dd>{run.metrics.durationLabel}</dd></div>)}</dl><a href={href(locale, `tasks/${task.id}/`)}>{labels.view} →</a></article>; })}</div></section>;
  })()}

  {section === 'compare' && <section class="shell page-block compare-page" data-compare-root data-locale={locale} data-base={href(locale)}>
    <div class="page-heading"><span class="eyebrow">SIDE BY SIDE</span><h1>{labels.compareTitle}</h1><p>{l ? '选择同一任务版本下的两条运行。选择会写入 URL，可直接分享和刷新恢复。' : 'Choose two runs for the same task version. Selections are stored in the URL for sharing and refresh.'}</p><p class="notice">{labels.crossModel}</p></div>
    <div class="compare-controls">
      <label><span>{labels.selectTask}</span><select data-compare-task>{catalog.tasks.map((task) => <option value={task.id}>{task.id} · {task.title[locale]}</option>)}</select></label>
      <label><span>{labels.left}</span><select data-compare-left></select></label>
      <label><span>{labels.right}</span><select data-compare-right></select></label>
      <button class="button" type="button" data-share>{labels.share}</button>
    </div>
    <p class="notice" data-compare-notice>{labels.unavailable}</p>
    <div class="compare-grid"><div data-left-panel></div><div data-right-panel><div class="missing-panel"><span>02</span><p>{labels.unavailable}</p></div></div></div>
    <script type="application/json" data-catalog set:html={JSON.stringify({ tasks: catalog.tasks, runs: catalog.runs, models: catalog.models, labels: { unavailable: labels.unavailable, invalid: labels.invalid, duration: labels.duration, tokens: labels.tokens, view: labels.view, copied: labels.copied, isolation: labels.isolation } })}></script>
  </section>}

  {section === 'methodology' && <section class="shell page-block methodology"><div class="page-heading"><span class="eyebrow">PROVENANCE FIRST</span><h1>{labels.methodology}</h1><p>{l ? '本网站呈现可追溯的归档记录，不把缺失值解释为零，也不把不同口径的数字压成排行榜。' : 'This site presents traceable archive records. Missing values are not zero, and incompatible measurements are not collapsed into a leaderboard.'}</p></div>
    <div class="principle-grid">{[
      [l ? '来源优先' : 'Provenance first', l ? '每条运行指标、Prompt 和评价均保留文件与行定位，并绑定各自的归档提交。' : 'Every prompt, run metric, and review retains its source file, line location, and archive commit.'],
      [l ? '评价分离' : 'Reviews stay separate', l ? '人工评价、各版 AI 评价和本次展示站验证不静默合并。' : 'Human reviews, each AI review version, and this site verification are never silently merged.'],
      [l ? '缺失即缺失' : 'Missing means missing', l ? '未知配置显示“未记录”，不推断单题费用或模型能力。' : 'Unknown configuration is shown as not recorded; per-task costs and capabilities are not inferred.'],
      [l ? '同题才比较' : 'Compare like with like', l ? '只有同一任务版本的运行可进入对比；跨模型比较必须注明 harness、预算与隔离差异。' : 'Only runs for the same task version can be compared; cross-model comparison must note harness, budget and isolation differences.'],
    ].map(([title, body], index) => <article><span>0{index + 1}</span><h2>{title}</h2><p>{body}</p></article>)}</div>
    <article class="prose-card wide"><h2>{l ? '历史结论如何展示' : 'How historical conclusions are presented'}</h2><p>{l ? '每条阶段评估都标注来源与口径：DeepSeek 的 93.6/100 引自历史 AI 报告；Muse Spark 的 84.9/100 来自维护 agent 的非盲评 v1。两者口径不同，不可直接比较，也不作为网站独立证明。任务 06、07 的人工观感与 AI 评估存在分歧，两种判断在运行详情中并列保留。' : 'Every phase assessment carries its source and method: the DeepSeek 93.6/100 is quoted from a historical AI report, while the Muse Spark 84.9/100 comes from the maintenance agent non-blind v1 review. The two use different rubrics and must not be compared directly; neither is an independent proof by this website. For tasks 06 and 07 the human judgment differs from the AI assessment, so both are retained side by side.'}</p></article>
    <div class="section-heading"><div><span class="eyebrow">BATCH MEASUREMENTS</span><h2>{labels.batchStats}</h2></div></div>
    <div class="batch-table">{catalog.batches.map((batch) => { const model = modelById(batch.modelId); return <article class="prose-card"><h2>{model?.name}</h2><dl class="metric-grid">{[['Tasks', batch.metrics.totalTasks], ['Sessions', batch.metrics.sessions], ['Duration', duration(batch.metrics.durationSeconds, locale)], ['API', batch.metrics.apiCalls], ['Tools', batch.metrics.toolCalls], ['Failures / retries', batch.metrics.failures], ['Input tokens', number(batch.metrics.inputTokens, locale)], ['Output tokens', number(batch.metrics.outputTokens, locale)], ['Cache read', number(batch.metrics.cacheReadTokens, locale)], [labels.cost, batch.metrics.costCny == null ? labels.notRecorded : `¥${batch.metrics.costCny}`]].map(([key, value]) => <div><span>{key}</span><strong>{value}</strong></div>)}</dl><a href={github(batch.source.path, batch.source.lines, catalog.runs.find((run) => run.modelId === batch.modelId)?.artifact.commit)} target="_blank" rel="noopener">{labels.sourceReport} ↗</a></article>; })}</div>
  </section>}

  {((section === 'tasks' && id && !currentTask) || (section === 'runs' && id && !currentRun) || (section === 'models' && id && !currentModel) || (section === 'phases' && id && !catalog.phases.some((phase) => phase.id === id))) && <section class="shell error-page"><span>404</span><h1>{l ? '未找到这条归档记录' : 'Archive record not found'}</h1><p>{l ? '链接中的标识不存在，或这条记录尚未进入公开索引。' : 'The identifier does not exist or is not included in the public index.'}</p><a class="button primary" href={href(locale)}>{l ? '返回概览' : 'Back to overview'}</a></section>}
</SiteLayout>

<script>
  // @ts-nocheck
  const filterPanel = document.querySelector<HTMLElement>('[data-filter-panel]');
  if (filterPanel) {
    const search = filterPanel.querySelector<HTMLInputElement>('[data-search]')!;
    const category = filterPanel.querySelector<HTMLSelectElement>('[data-category]')!;
    const model = filterPanel.querySelector<HTMLSelectElement>('[data-model]')!;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-task-card]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const apply = () => {
      const query = search.value.trim().toLowerCase(); let visible = 0;
      cards.forEach((card) => {
        const show = (!query || card.dataset.search?.includes(query))
          && (!category.value || card.dataset.category === category.value)
          && (!model.value || card.dataset.model === model.value);
        card.hidden = !show; if (show) visible++;
      });
      empty.hidden = visible > 0;
    };
    search.addEventListener('input', apply); category.addEventListener('change', apply); model.addEventListener('change', apply);
  }

  const compareRoot = document.querySelector<HTMLElement>('[data-compare-root]');
  if (compareRoot) {
    const data = JSON.parse(compareRoot.querySelector('[data-catalog]')!.textContent || '{}');
    const taskSelect = compareRoot.querySelector<HTMLSelectElement>('[data-compare-task]')!;
    const leftSelect = compareRoot.querySelector<HTMLSelectElement>('[data-compare-left]')!;
    const rightSelect = compareRoot.querySelector<HTMLSelectElement>('[data-compare-right]')!;
    const notice = compareRoot.querySelector<HTMLElement>('[data-compare-notice]')!;
    const leftPanel = compareRoot.querySelector<HTMLElement>('[data-left-panel]')!;
    const rightPanel = compareRoot.querySelector<HTMLElement>('[data-right-panel]')!;
    const params = new URLSearchParams(location.search);
    const requestedTask = params.get('task');
    if (data.tasks.some((task: any) => task.id === requestedTask)) taskSelect.value = requestedTask;
    const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!));
    const runsFor = () => data.runs.filter((run: any) => run.taskId === taskSelect.value);
    const fill = () => {
      const runs = runsFor();
      const options = runs.map((run: any) => {
        const model = data.models.find((entry: any) => entry.id === run.modelId);
        return `<option value="${esc(run.id)}">${esc(model ? model.name : run.modelId)} · ${esc(run.id)}</option>`;
      }).join('');
      leftSelect.innerHTML = options;
      rightSelect.innerHTML = `<option value="">-</option>${options}`;
      const wantedLeft = params.get('left'); const wantedRight = params.get('right');
      if (runs.some((run: any) => run.id === wantedLeft)) leftSelect.value = wantedLeft;
      if (runs.some((run: any) => run.id === wantedRight) && wantedRight !== leftSelect.value) rightSelect.value = wantedRight;
      render();
    };
    const panel = (runId: string, side: string) => {
      const run = data.runs.find((entry: any) => entry.id === runId); if (!run) return `<div class="missing-panel"><span>02</span><p>${esc(data.labels.unavailable)}</p></div>`;
      const task = data.tasks.find((entry: any) => entry.id === run.taskId); const model = data.models.find((entry: any) => entry.id === run.modelId);
      const artifact = `${compareRoot.dataset.base?.replace(/\/(zh|en)\/$/, '/') || '/'}artifacts/${run.id}/${run.artifact.entry}`;
      const visual = run.artifact.type === 'svg' ? `<img src="${esc(artifact)}" alt="${esc(task.title[compareRoot.dataset.locale])}">` : `<iframe src="${esc(artifact)}" sandbox="${esc(run.artifact.preview.sandbox)}" title="${esc(task.title[compareRoot.dataset.locale])}"></iframe>`;
      return `<article class="comparison-panel"><span class="eyebrow">${esc(side)} · ${esc(run.id)}</span><h2>${esc(model.name)}</h2><div class="compare-preview">${visual}</div><dl><div><dt>${esc(data.labels.duration)}</dt><dd>${esc(run.metrics.durationLabel)}</dd></div><div><dt>${esc(data.labels.tokens)}</dt><dd>${new Intl.NumberFormat().format(run.metrics.totalTokens)}</dd></div><div><dt>API</dt><dd>${esc(run.metrics.apiCalls)}</dd></div><div><dt>Tools</dt><dd>${esc(run.metrics.toolCalls)}</dd></div></div><a href="${esc(compareRoot.dataset.base)}runs/${esc(run.id)}/">${esc(data.labels.view)} →</a></article>`;
    };
    const render = () => {
      if (rightSelect.value === leftSelect.value) rightSelect.value = '';
      leftPanel.innerHTML = panel(leftSelect.value, '01'); rightPanel.innerHTML = panel(rightSelect.value, '02');
      notice.hidden = runsFor().length > 1;
      const next = new URL(location.href); next.searchParams.set('task', taskSelect.value); next.searchParams.set('left', leftSelect.value); rightSelect.value ? next.searchParams.set('right', rightSelect.value) : next.searchParams.delete('right'); history.replaceState({}, '', next);
    };
    taskSelect.addEventListener('change', fill); leftSelect.addEventListener('change', render); rightSelect.addEventListener('change', render);
    compareRoot.querySelector('[data-share]')?.addEventListener('click', async (event) => { await navigator.clipboard.writeText(location.href); const button = event.currentTarget as HTMLButtonElement; const old = button.textContent; button.textContent = data.labels.copied; setTimeout(() => button.textContent = old, 1400); });
    fill();
  }
</script>
