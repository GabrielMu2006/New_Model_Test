---
// 页面路由：把 [locale]/[...path] 解析成具体页面组件。
// 文案、编号与展示组件都拆到 lib 与 components/pages，这里只负责选页与 <title>。
import SiteLayout from '../layouts/SiteLayout.astro';
import { catalog, modelById, runById, taskById, type Locale } from '../lib/catalog';
import { labelsFor } from '../lib/labels';
import HomePage from './pages/HomePage.astro';
import TasksIndex from './pages/TasksIndex.astro';
import TaskDetail from './pages/TaskDetail.astro';
import RunDetail from './pages/RunDetail.astro';
import ModelsIndex from './pages/ModelsIndex.astro';
import ModelDetail from './pages/ModelDetail.astro';
import PhasesIndex from './pages/PhasesIndex.astro';
import PhaseDetail from './pages/PhaseDetail.astro';
import ComparePage from './pages/ComparePage.astro';
import MethodologyPage from './pages/MethodologyPage.astro';
import NotFoundPage from './pages/NotFoundPage.astro';

interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const t = labelsFor(locale);
const bits = path.split('/').filter(Boolean);
const section = bits[0] || 'home';
const id = bits[1];

const currentTask = taskById(id);
const currentRun = runById(id);
const currentModel = modelById(id);
const currentPhase = section === 'phases' ? catalog.phases.find((phase) => phase.id === id) : undefined;
const currentRunTask = currentRun ? taskById(currentRun.taskId) : undefined;
/**
 * 标题解析顺序：任务 → 模型 → （运行页）该运行所属任务 → 阶段 → 各列表页的通用标题。
 * 运行页的 id 是 runId，currentTask 必为 undefined，因此必须用 currentRunTask 取名，
 * 否则 110 个运行页的 <title> 会全部回落成站点名。
 */
const pageTitle = currentTask?.title[locale]
  || currentModel?.name[locale]
  || currentRunTask?.title[locale]
  || currentPhase?.name[locale]
  || (section === 'compare' ? t.compareTitle : section === 'methodology' ? t.methodology : section === 'phases' ? t.phases : section === 'models' ? t.modelArchive : section === 'tasks' ? t.taskArchive : t.brandSubtitle);
const notFound = (section === 'tasks' && id && !currentTask)
  || (section === 'runs' && id && !currentRun)
  || (section === 'models' && id && !currentModel)
  || (section === 'phases' && id && !currentPhase && Boolean(id));
---
<SiteLayout locale={locale} title={pageTitle} description={t.heroIntro} alternatePath={path} section={section}>
  {section === 'home' && <HomePage locale={locale} />}
  {section === 'tasks' && !id && <TasksIndex locale={locale} />}
  {section === 'tasks' && currentTask && <TaskDetail locale={locale} task={currentTask} />}
  {section === 'runs' && currentRun && <RunDetail locale={locale} run={currentRun} />}
  {section === 'models' && !id && <ModelsIndex locale={locale} />}
  {section === 'models' && currentModel && <ModelDetail locale={locale} model={currentModel} />}
  {section === 'phases' && !id && <PhasesIndex locale={locale} />}
  {section === 'phases' && currentPhase && <PhaseDetail locale={locale} phase={currentPhase} />}
  {section === 'compare' && <ComparePage locale={locale} />}
  {section === 'methodology' && <MethodologyPage locale={locale} />}
  {notFound && <NotFoundPage locale={locale} />}
</SiteLayout>
