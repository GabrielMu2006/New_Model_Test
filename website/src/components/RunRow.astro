---
import { compact, duration, href, modelById, number, type Locale, type Run } from '../lib/catalog';
interface Props { locale: Locale; run: Run; }
const { locale, run } = Astro.props;
const model = modelById(run.modelId);
const l = locale === 'zh';
const labels = {
  // 缺失值一律显示「未记录」，不能留空单元格：同一行里有的缺失显示「未记录」、
  // 有的显示空白，会被读成「这一项是 0 或没问题」。
  duration: l ? '累计用时' : 'Total duration',
  tokens: l ? 'Token 过路量' : 'Token throughput',
  api: l ? 'API 调用' : 'API calls',
  view: l ? '查看详情' : 'View details',
  notRecorded: l ? '未记录' : 'Not recorded',
};
const durationText = run.metrics.durationLabel ?? (run.metrics.durationSeconds == null ? labels.notRecorded : duration(run.metrics.durationSeconds, locale));
---
<article class="run-row">
  <div><span class="status-dot"></span><strong>{model?.name[locale]}</strong><small>{run.id}</small></div>
  <dl>
    <div><dt>{labels.duration}</dt><dd>{durationText}</dd></div>
    <div><dt>{labels.tokens}</dt><dd>{compact(run.metrics.totalTokens, locale)}</dd></div>
    <div><dt>{labels.api}</dt><dd>{number(run.metrics.apiCalls, locale)}</dd></div>
  </dl>
  <a class="button quiet" href={href(locale, `runs/${run.id}/`)}>{labels.view} →</a>
</article>
