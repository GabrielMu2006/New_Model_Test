---
import '../styles/global.css';
import { base } from '../lib/catalog';
const links = [
  { href: `${base}/zh/`, label: '中文首页' },
  { href: `${base}/en/`, label: 'English home' },
  { href: `${base}/zh/tasks/`, label: '任务 / Tasks' },
  { href: `${base}/zh/compare/`, label: '对比 / Compare' },
];
---
<!doctype html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="color-scheme" content="dark"><link rel="icon" href={`${base}/favicon.svg`}><title>404 · 模型评测档案</title></head><body><main class="shell error-page"><span>404</span><h1>未找到页面 / Page not found</h1><p>这条公开路径不存在。The requested public path does not exist.</p><nav class="button-row" aria-label="站点入口 / Site links">{links.map((link) => <a class="button" href={link.href}>{link.label}</a>)}</nav></main></body></html>
