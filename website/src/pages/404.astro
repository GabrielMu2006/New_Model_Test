---
// 独立 404 页面：GitHub Pages 对未知路径返回本页（构建产物 dist/404.html）。
// 视觉与站内 404 内容块保持一致，并保留中英双语入口与 favicon。
import '../styles/global.css';
import { base, href } from '../lib/catalog';
import { labelsFor } from '../lib/labels';
import { site } from '../lib/site';

const zh = labelsFor('zh');
const links = [
  { url: href('zh'), label: '中文首页' },
  { url: href('en'), label: 'English home' },
  { url: href('zh', 'tasks/'), label: zh.allTasks },
  { url: href('zh', 'compare/'), label: zh.compareTitle },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f1efe9" />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <title>404 · {site.name}</title>
  </head>
  <body>
    <main class="shell error-page">
      <span aria-hidden="true">404</span>
      <h1>未找到页面 / Page not found</h1>
      <p>这条公开路径不存在。The requested public path does not exist.</p>
      <p class="note mono">{site.archiveLabel}</p>
      <nav class="button-row" aria-label="站点入口 / Site links">
        {links.map((link) => <a class="button" href={link.url}>{link.label}</a>)}
      </nav>
    </main>
  </body>
</html>
