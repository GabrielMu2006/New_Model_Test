---
import '../styles/global.css';
import { asset, catalog, href, modelById, taskById, type Locale } from '../lib/catalog';
import { labelsFor } from '../lib/labels';
import { jsonIsland } from '../lib/serialize';
import { navItems, site } from '../lib/site';

interface Props { locale: Locale; title: string; description?: string; alternatePath?: string; section?: string; }
const { locale, title, description = '', alternatePath = '', section = 'home' } = Astro.props;
const other: Locale = locale === 'zh' ? 'en' : 'zh';
const t = labelsFor(locale);
// 首页的标题就是站点名，直接用 `title · brand` 会渲染成「模型评测档案 · 模型评测档案」。
const documentTitle = title.trim().toLowerCase() === t.brandSubtitle.trim().toLowerCase() ? title : `${title} · ${site.name}`;
const repository = catalog.repository;
/**
 * 全站搜索索引（命令面板，设计规范第 47、48 节）：任务 / 模型 / 运行三类。
 * 在构建期生成，客户端只做过滤，不重新拼装文案。
 */
const searchIndex = [
  ...catalog.tasks.map((task) => ({
    kind: 'task' as const,
    id: task.id,
    label: `${task.title[locale]} · ${task.title[other]}`,
    meta: `${task.id}@${task.version} · ${href(locale, `tasks/${task.id}/`)}`,
    url: href(locale, `tasks/${task.id}/`),
    haystack: `${task.id} ${task.title.zh} ${task.title.en} ${task.promptOriginal} ${task.promptTranslation ?? ''} ${task.category}`.toLowerCase(),
  })),
  ...catalog.models.map((model) => ({
    kind: 'model' as const,
    id: model.id,
    label: model.name[locale],
    meta: `${model.provider}${model.version ? ` · ${model.version}` : ''}`,
    url: href(locale, `models/${model.id}/`),
    haystack: `${model.id} ${model.name.zh} ${model.name.en} ${model.provider} ${model.notes.zh} ${model.notes.en}`.toLowerCase(),
  })),
  ...catalog.runs.map((run) => {
    const task = taskById(run.taskId);
    const model = modelById(run.modelId);
    return {
      kind: 'run' as const,
      id: run.id,
      label: `${task?.title[locale] ?? run.taskId} · ${model?.name[locale] ?? run.modelId}`,
      meta: run.id,
      url: href(locale, `runs/${run.id}/`),
      haystack: `${run.id} ${run.taskId} ${run.modelId} ${task?.title.zh ?? ''} ${task?.title.en ?? ''} ${model?.name.zh ?? ''} ${model?.name.en ?? ''}`.toLowerCase(),
    };
  }),
];
const kindLabel: Record<string, string> = { task: t.searchTaskGroup, model: t.searchModelGroup, run: t.searchRunGroup };
const homeUrl = href(locale);
const canonical = new URL(`${homeUrl}${alternatePath}`.replace(/\/{2,}/g, '/'), Astro.site ?? 'https://vibetest.gabrielmu2006.cn').toString();
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f1efe9" />
    <link rel="icon" href={asset('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'zh' ? 'zh-Hans' : 'en'} href={`${homeUrl}${alternatePath}`} />
    <link rel="alternate" hreflang={other === 'zh' ? 'zh-Hans' : 'en'} href={href(other, alternatePath)} />
    <link rel="preload" href="/fonts/playfair-display-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header" data-site-header data-nav-open="false">
      <a class="brand" href={homeUrl} aria-label={`${site.name} · ${t.brandSubtitle}`}>
        <strong>{site.name}</strong>
        <small>{t.brandSubtitle}</small>
      </a>
      <nav aria-label={t.navLabel}>
        {navItems.map((item) => (
          <a href={href(locale, item.path)} aria-current={section === item.key ? 'page' : undefined}>{item.label[locale]}</a>
        ))}
      </nav>
      <div class="header-actions">
        <button class="header-button" type="button" data-palette-open aria-label={t.searchOpen}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" /></svg>
          <span class="mono kbd-hint" aria-hidden="true">⌘K</span>
        </button>
        <a class="header-button lang-switch" href={href(other, alternatePath)} data-language-switch aria-label={t.languageLabel}>{t.language}</a>
        <a class="header-button" href={repository} target="_blank" rel="noopener" aria-label={t.repository}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 5-2 5-5.5a4.3 4.3 0 0 0-1.2-3 4 4 0 0 0-.1-3s-1.1-.3-3.5 1.3a12 12 0 0 0-6.4 0C5.4 2.7 4.3 3 4.3 3a4 4 0 0 0-.1 3A4.3 4.3 0 0 0 3 9c0 3.5 2 5.5 5 5.5a4.8 4.8 0 0 0-1 3.5V22" /><path d="M9 22v-2.5c-1.5.6-2.5 0-3-1.5" /></svg>
          <span aria-hidden="true">↗</span>
        </a>
        <button class="header-button menu-toggle" type="button" data-nav-toggle aria-expanded="false" aria-label={t.menu}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>{site.name}</strong>
          <small>{t.brandSubtitle}</small>
          <p>{site.archiveLabel} · {t.footerTagline}。</p>
          <p>{t.footerStance}</p>
        </div>
        <div class="footer-col">
          <h2>{t.footerLinks}</h2>
          <ul>
            <li><a href={href(locale, 'tasks/')}>{t.allTasks}</a></li>
            <li><a href={href(locale, 'models/')}>{t.allModels}</a></li>
            <li><a href={href(locale, 'phases/')}>{t.phases}</a></li>
            <li><a href={href(locale, 'compare/')}>{t.compareTitle}</a></li>
            <li><a href={href(locale, 'methodology/')}>{t.methodology}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>{t.footerContact}</h2>
          <ul>
            <li><a href={repository} target="_blank" rel="noopener">GitHub ↗</a></li>
            <li><a href="mailto:limuzhi2006@stu.pku.edu.cn">limuzhi2006@stu.pku.edu.cn</a></li>
            <li><a href={site.personalSite} target="_blank" rel="me noopener">{t.footerPersonal} ↗</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>{t.footerNote}</span>
        <span>Same prompts. Real outputs. Independent reviews.</span>
      </div>
    </footer>

    <div class="palette" data-palette hidden>
      <div class="palette-panel" role="dialog" aria-modal="true" aria-label={t.searchTitle}>
        <div class="palette-head">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" /></svg>
          <input type="search" data-palette-input placeholder={t.searchPlaceholderFull} aria-label={t.searchTitle} autocomplete="off" />
          <button type="button" data-palette-close aria-label={t.searchClose}>ESC</button>
        </div>
        <p class="palette-hint">{t.searchHint}</p>
        <ul class="palette-results" data-palette-results aria-live="polite"></ul>
        <p class="palette-empty" data-palette-empty hidden>{t.searchEmpty}</p>
      </div>
    </div>

    <script is:inline type="application/json" data-search-index set:html={jsonIsland({ entries: searchIndex, labels: kindLabel, empty: t.searchEmpty })} />
    <script>
      // 命令面板（设计规范第 48 节）：构建期索引 + 客户端过滤；无脚本时页面其余部分不受影响。
      const palette = document.querySelector<HTMLElement>('[data-palette]');
      const indexNode = document.querySelector<HTMLElement>('[data-search-index]');
      if (palette && indexNode) {
        const data = JSON.parse(indexNode.textContent || '{"entries":[],"labels":{}}');
        const input = palette.querySelector<HTMLInputElement>('[data-palette-input]')!;
        const list = palette.querySelector<HTMLUListElement>('[data-palette-results]')!;
        const empty = palette.querySelector<HTMLElement>('[data-palette-empty]')!;
        const openButton = document.querySelector<HTMLElement>('[data-palette-open]');
        const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!));
        let active = -1;
        const render = () => {
          const query = input.value.trim().toLowerCase();
          const matches = (query
            ? data.entries.filter((entry: any) => entry.haystack.includes(query))
            : data.entries.filter((entry: any) => entry.kind === 'task')).slice(0, 12);
          list.innerHTML = matches.map((entry: any, position: number) => `<li><a href="${esc(entry.url)}" data-active="${position === active}" data-palette-item><i>${esc(data.labels[entry.kind] ?? entry.kind)}</i><span><strong>${esc(entry.label)}</strong><small>${esc(entry.meta)}</small></span></a></li>`).join('');
          empty.hidden = matches.length > 0;
        };
        const openPalette = () => {
          palette.hidden = false;
          active = -1;
          input.value = '';
          render();
          input.focus();
        };
        const closePalette = () => { palette.hidden = true; openButton?.focus(); };
        const items = () => [...list.querySelectorAll<HTMLAnchorElement>('[data-palette-item]')];
        const setActive = (next: number) => {
          const all = items();
          if (!all.length) return;
          active = (next + all.length) % all.length;
          all.forEach((item, position) => item.dataset.active = String(position === active));
          all[active]?.scrollIntoView({ block: 'nearest' });
        };
        openButton?.addEventListener('click', openPalette);
        palette.querySelector('[data-palette-close]')?.addEventListener('click', closePalette);
        palette.addEventListener('click', (event) => { if (event.target === palette) closePalette(); });
        input.addEventListener('input', () => { active = -1; render(); });
        input.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') { event.preventDefault(); setActive(active + 1); }
          else if (event.key === 'ArrowUp') { event.preventDefault(); setActive(active - 1); }
          else if (event.key === 'Enter') { const all = items(); const target = all[active] ?? all[0]; if (target) location.href = target.href; }
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !palette.hidden) { closePalette(); return; }
          const typing = /^(input|textarea|select)$/i.test((event.target as HTMLElement)?.tagName ?? '');
          if (typing) return;
          if (event.key === '/' || (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey))) { event.preventDefault(); openPalette(); }
        });
      }

      // 移动端导航开关：桌面端由 CSS 强制显示导航，这里的属性只影响窄屏。
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const navToggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
      navToggle?.addEventListener('click', () => {
        const open = header?.dataset.navOpen === 'true';
        if (header) header.dataset.navOpen = String(!open);
        navToggle.setAttribute('aria-expanded', String(!open));
      });

      // 语言切换必须保留查询参数（对比页的 task/left/right 依赖它）。
      const switcher = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
      if (switcher && location.search) switcher.href += location.search;
    </script>
  </body>
</html>
